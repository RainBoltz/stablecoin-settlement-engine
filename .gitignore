# Foundry build artifacts
out/
cache/

# Foundry broadcast logs for the local devnet
contracts/evm/broadcast/*/31337/
contracts/evm/broadcast/**/dry-run/

# Local devnet runtime: anvil state, pid, log
.devnet/

# Generated by script/DeployTokenZoo.s.sol; regenerate with `make devnet`
contracts/evm/deployments/*.json
!contracts/evm/deployments/.gitkeep

# Rust build artifacts for the Solana program
contracts/solana/payout-run/target/
# The program keypair cargo-build-sbf generates: a local artifact, never a shared identity
contracts/solana/payout-run/*-keypair.json
